            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"string-literals\">String literals</h2>\n<span class=\"paragraph\">String literals are surrounded by single or double quotation marks. <code>'hello'</code> is the same as <code>\"hello\"</code>.</span></span>"
